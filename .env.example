# Banco
POSTGRES_USER=pokelab
POSTGRES_PASSWORD=trocar-em-producao
POSTGRES_DB=pokelab
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API
API_PORT=8000
# Esta chave esta no repositorio e portanto e publica: serve para desenvolver
# e nada mais. A API recusa subir em producao com ela, ou com qualquer valor
# versionado aqui. Gere a sua com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=desenvolvimento-apenas
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Jogo (ADR-004) - divide todas as duracoes de expedicao.
# 1.0 = tempo real. 0.01 = 20 minutos viram 12 segundos.
EXPEDITION_TIME_SCALE=0.01

# Conta de desenvolvimento, criada por `make conta-teste`.
# Vale apenas no ambiente local: o registro e aberto, entao recriar e trivial.
# Troque a senha no seu .env se quiser; este arquivo e versionado e nada aqui
# deve valer em lugar nenhum fora da sua maquina.
DEV_PROFESSOR_USUARIO=professor
DEV_PROFESSOR_SENHA=laboratorio-de-desenvolvimento
DEV_PROFESSOR_LABORATORIO="Lab Pallet"

# Web
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
